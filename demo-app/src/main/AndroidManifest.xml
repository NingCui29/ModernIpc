<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:label="ModernIPC Demo"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- Client UI runs in main process -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Server Service runs in isolated :server process -->
        <service
            android:name=".MyBrokerService"
            android:exported="false"
            android:process=":server" />

        <!-- Explicit lifecycle test endpoints; never exposed outside this app. -->
        <service
            android:name=".NullBindingService"
            android:exported="false"
            android:process=":server" />
        <service
            android:name=".DelayedBindingService"
            android:exported="false"
            android:process=":server" />

        <!-- Broker schema fixtures, reachable only by the explicit compatibility probe. -->
        <service
            android:name=".CompatibilityBrokerService"
            android:exported="false"
            android:process=":server" />
        <service
            android:name=".LegacyBrokerService"
            android:exported="false"
            android:process=":server" />

        <!-- Explicit cold-discovery fault fixture; its controls require the application UID. -->
        <service
            android:name=".ColdDiscoveryBrokerService"
            android:exported="false"
            android:process=":server" />

        <!-- Raw-bind controls keep real blocked handshakes isolated from ordinary demo connections. -->
        <service
            android:name=".HandshakeBlockingService"
            android:exported="false"
            android:process=":server" />

    </application>
</manifest>
